{
  "name": "voicecollector-desktop",
  "productName": "VoiceCollector",
  "version": "1.0.1",
  "description": "VoiceCollector 桌面版 · 大学课堂实时记录、中文翻译与课堂笔记生成",
  "author": {
    "name": "VoiceCollector",
    "email": "noreply@example.com"
  },
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke-test",
    "sync": "node scripts/sync-web.js",
    "dist": "npm run preflight && npm run sync && electron-builder && npm run smoke:packed && npm run clean:staging",
    "dist:mac": "npm run preflight && npm run sync && electron-builder --mac && npm run smoke:packed && npm run clean:staging",
    "dist:win": "npm run preflight && npm run sync && electron-builder --win",
    "dist:dir": "npm run preflight && npm run sync && electron-builder --dir && npm run smoke:packed",
    "preflight": "node scripts/preflight.mjs",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "clean:staging": "node scripts/clean-staging.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.voicecollector.classroom",
    "productName": "VoiceCollector",
    "copyright": "Copyright © 2026 VoiceCollector",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "app-web/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**"
    ],
    "extraMetadata": {
      "name": "VoiceCollector"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "VoiceCollector 需要使用麦克风来实时录制课堂内容，并转写成文字与中文翻译。录音只保存在你自己的电脑上。",
        "NSCameraUsageDescription": "VoiceCollector 不使用摄像头。",
        "NSSpeechRecognitionUsageDescription": "VoiceCollector 在本机把课堂录音转写成文字。",
        "LSMinimumSystemVersion": "13.0",
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "VoiceCollector ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VoiceCollector"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    }
  }
}
